rules_version = '2';

// Bee-to-Bee Operations — Firestore security rules.
//
// Role-restricted sections were added for IG2S5-42 (Area Manager, Supply Chain
// Officer, Legal Head). The "existing collections" section is an assumption:
// it grants any signed-in user access, which is what the Business Development
// and Executive Management dashboards need today. BEFORE DEPLOYING, compare
// this file with the rules currently published in the Firebase console
// (Firestore Database → Rules) and merge rather than overwrite.
//
// Deploy: paste into the console and Publish, or `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return signedIn() ? request.auth.token.email.lower() : ''; }

    // Keep in sync with ROLE_ACCOUNTS in src/js/role-backend.js.
    function isAreaManager() { return email() in ['bea.hernandez@5joys.com']; }
    function isSupplyChain() { return email() in ['joel.navarro@5joys.com']; }
    function isLegalHead()   { return email() in ['atty.maya.santos@5joys.com']; }
    function isExecutive()   { return email() in ['maria.santos@5joys.com']; }
    function isStoreManager() { return email() in ['ruth.reyes@5joys.com', 'ruth.torres@5joys.com']; }
    function isStoreTrainer() { return email() == 'michael.dela.cruz@5joys.com'; }
    function isEngineeringHead() { return email() == 'engr.nina.cruz@5joys.com'; }
    function isOperationsHead() { return email() == 'carlos.reyes@5joys.com'; }
    function isFinanceHead() { return email() == 'carlo.lim@5joys.com'; }
    function isHrSpecialist() { return email() == 'angela.santos@5joys.com'; }

    function stamped() {
      return request.resource.data.updatedBy == email() || request.resource.data.createdBy == email()
        || 'seededAt' in request.resource.data;
    }
    function shortText(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // ---------- Area Manager ----------
    match /areaBranches/{id} {
      allow read: if isAreaManager() || isExecutive();
      allow write: if isAreaManager() && stamped() && shortText('note', 1000);
    }
    match /areaDailyReports/{id} {
      allow read: if isAreaManager() || isExecutive();
      allow write: if isAreaManager() && stamped() && shortText('managerNote', 1000)
        && request.resource.data.status in ['For Review', 'Reviewed', 'Action Required', 'Pending'];
    }
    match /areaIncidents/{id} {
      allow read: if isAreaManager() || isExecutive();
      allow write: if isAreaManager() && stamped()
        && shortText('title', 160) && shortText('note', 1000) && shortText('owner', 80)
        && request.resource.data.priority in ['High', 'Medium', 'Low']
        && request.resource.data.status in ['Under Investigation', 'Action Required', 'Monitoring', 'Resolved'];
    }
    match /areaCorrectiveActions/{id} {
      allow read: if isAreaManager() || isExecutive();
      allow write: if isAreaManager() && stamped()
        && shortText('title', 160) && shortText('note', 1000) && shortText('owner', 80)
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0 && request.resource.data.progress <= 100
        && request.resource.data.status in ['In Progress', 'Monitoring', 'Overdue', 'Completed'];
    }
    match /areaPerformance/{id} {
      allow read: if isAreaManager() || isExecutive();
      allow write: if isAreaManager() && stamped() && shortText('note', 1000);
    }
    match /areaActivity/{id} {
      allow read: if isAreaManager();
      allow create: if isAreaManager();
      allow update, delete: if false; // append-only audit trail
    }

    // ---------- Supply Chain Officer ----------
    match /supplyDeliveries/{id} {
      allow read: if isSupplyChain() || isStoreManager() || isExecutive();
      allow write: if isSupplyChain() && stamped()
        && shortText('item', 80) && shortText('supplier', 80) && shortText('note', 1000)
        && request.resource.data.expected is int && request.resource.data.expected >= 1
        && request.resource.data.received is int && request.resource.data.received >= 0
        && request.resource.data.received <= request.resource.data.expected
        && request.resource.data.status in ['Scheduled', 'In Transit', 'Received', 'Incomplete', 'Delayed', 'Damaged'];
    }
    match /supplyLaunchConfirmations/{id} {
      allow read: if isSupplyChain() || isStoreManager() || isExecutive();
      allow write: if isSupplyChain() && stamped()
        && shortText('subject', 160) && shortText('message', 1000);
    }

    // ---------- Legal Head ----------
    match /legalReviews/{proposalId} {
      allow read: if isLegalHead() || isExecutive();
      allow write: if isLegalHead() && stamped()
        && request.resource.data.status in ['Approved', 'Revision Requested', 'Rejected']
        && shortText('remarks', 1000);
    }
    match /operationsReviews/{proposalId} {
      allow read: if isOperationsHead() || isExecutive();
      allow create, update: if isOperationsHead() && request.resource.data.updatedBy == email()
        && request.resource.data.status in ['Approved', 'Revision Requested', 'Rejected']
        && shortText('remarks', 1000);
      allow delete: if false;
    }
    match /financeReviews/{proposalId} {
      allow read: if isFinanceHead() || isExecutive();
      allow create, update: if isFinanceHead() && request.resource.data.updatedBy == email()
        && request.resource.data.status in ['Approved', 'Revision Requested', 'Rejected']
        && shortText('remarks', 1000);
      allow delete: if false;
    }
    match /hrApplicants/{id} {
      allow read: if isHrSpecialist();
      allow create, update: if isHrSpecialist() && request.resource.data.updatedBy == email()
        && request.resource.data.status in ['New Applicant','For Screening','Shortlisted','Interview Scheduled','Interview Completed','For Further Review','Hired','Rejected','Assigned to Training']
        && request.resource.data.certification in ['Not Started','In Training','Certified','Retraining Required']
        && (!request.resource.data.get('deployed', false) || request.resource.data.certification == 'Certified');
      allow delete: if false;
    }
    match /hrBatches/{id} {
      allow read: if isHrSpecialist();
      allow create, update: if isHrSpecialist() && request.resource.data.updatedBy == email()
        && request.resource.data.capacity is int && request.resource.data.capacity > 0
        && request.resource.data.assigned is int && request.resource.data.assigned >= 0
        && request.resource.data.assigned <= request.resource.data.capacity;
      allow delete: if false;
    }

    // ---------- Site proposal documents (uploaded by Business Development) ----------
    function isBusinessDevelopment() { return email() in ['sophia.ramirez@5joys.com']; }
    function isDepartmentHead() {
      return email() in ['carlos.reyes@5joys.com', 'carlo.lim@5joys.com',
                         'engr.nina.cruz@5joys.com', 'atty.maya.santos@5joys.com'];
    }
    match /siteDocuments/{documentId} {
      allow read: if isBusinessDevelopment() || isDepartmentHead() || isExecutive();
      allow create: if isBusinessDevelopment()
        && request.resource.data.uploadedBy == email()
        && request.resource.data.size is int && request.resource.data.size <= 10 * 1024 * 1024
        && request.resource.data.type in ['application/pdf', 'image/jpeg', 'image/png'];
      allow update, delete: if false;
      match /chunks/{chunk} {
        allow read: if isBusinessDevelopment() || isDepartmentHead() || isExecutive();
        allow create: if isBusinessDevelopment();
        allow update, delete: if false;
      }
    }

    // ---------- Shared ----------
    match /counters/{name} {
      allow read, write: if (name in ['areaIncidents', 'areaCorrectiveActions'] && isAreaManager())
        || (name == 'supplyDeliveries' && isSupplyChain());
    }
    match /userSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Shared site workflow ----------
    match /siteApplications/{id} {
      allow read: if isBusinessDevelopment() || isDepartmentHead() || isExecutive();
      allow create, delete: if isBusinessDevelopment();
      allow update: if isBusinessDevelopment()
        || (isOperationsHead() && resource.data.workflowStatus is map
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowStatus','operationsUpdatedAt','operationsUpdatedBy'])
          && request.resource.data.workflowStatus.diff(resource.data.workflowStatus).affectedKeys().hasOnly(['operations'])
          && request.resource.data.operationsUpdatedBy == email())
        || (isFinanceHead() && resource.data.workflowStatus is map
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowStatus','financeUpdatedAt','financeUpdatedBy'])
          && request.resource.data.workflowStatus.diff(resource.data.workflowStatus).affectedKeys().hasOnly(['finance'])
          && request.resource.data.financeUpdatedBy == email())
        || (isLegalHead() && resource.data.workflowStatus is map
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowStatus','legalUpdatedAt','legalUpdatedBy'])
          && request.resource.data.workflowStatus.diff(resource.data.workflowStatus).affectedKeys().hasOnly(['legal'])
          && request.resource.data.legalUpdatedBy == email());
    }
    match /siteArchives/{id} {
      allow read: if isBusinessDevelopment() || isExecutive();
      allow write: if isBusinessDevelopment();
    }
    match /businessDevelopment/{id} {
      allow read: if isBusinessDevelopment() || isExecutive();
      allow write: if isBusinessDevelopment();
    }
    match /executiveReviews/{id} {
      allow read: if isExecutive();
      allow create, update: if isExecutive()
        && request.resource.data.reviewedBy == request.auth.uid
        && shortText('note', 1000);
      allow delete: if false;
    }
  }
}
